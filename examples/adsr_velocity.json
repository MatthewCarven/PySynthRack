    { "src_module_id": 6, "src_port": "out",  "dst_module_id": 8, "dst_port": "in" },
    { "src_module_id": 7, "src_port": "cv",   "dst_module_id": 8, "dst_port": "cutoff_cv" },
    { "src_module_id": 8, "src_port": "out",  "dst_module_id": 9, "dst_port": "audio" },
