{
  "version": 1,
  "next_id": 9,
  "modules": [
    {
      "id": 1,
      "type": "clock",
      "name": "Sixteenths (120 BPM)",
      "params": { "bpm": 120.0, "division": 4.0, "pulse_width": 0.5 }
    },
    {
      "id": 2,
      "type": "clock_divider",
      "name": "Divider - div2 = eighths, divn 16 = the bar",
      "params": { "n": 16, "m": 2, "swing": 0.0, "pw": 0.5 }
    },
    {
      "id": 3,
      "type": "sequencer",
      "name": "Melody - pendulum over 5 steps (1 2 3 4 5 4 3 2 = one bar of eighths)",
      "params": {
        "steps": 5,
        "direction": "pendulum",
        "seed": 1,
        "step1_pitch": 0.0,  "step1_on": true,
        "step2_pitch": 3.0,  "step2_on": true,
        "step3_pitch": 7.0,  "step3_on": true,
        "step4_pitch": 10.0, "step4_on": true,
        "step5_pitch": 12.0, "step5_on": true
      }
    },
    {
      "id": 4,
      "type": "pluck",
      "name": "Pluck (C4 base)",
      "params": { "decay": 1.5, "damping": 0.5, "color": 0.7, "position": 0.2, "level": 0.5 }
    },
    {
      "id": 5,
      "type": "sequencer",
      "name": "Hat pattern - random, seed 7; pitches double as accents, rests on 2 and 5",
      "params": {
        "steps": 6,
        "direction": "random",
        "seed": 7,
        "step1_pitch": 12.0, "step1_on": true,
        "step2_pitch": 6.0,  "step2_on": false,
        "step3_pitch": 9.0,  "step3_on": true,
        "step4_pitch": 3.0,  "step4_on": true,
        "step5_pitch": 12.0, "step5_on": false,
        "step6_pitch": 6.0,  "step6_on": true
      }
    },
    {
      "id": 6,
      "type": "hat_drum",
      "name": "Closed hat",
      "params": { "decay_closed": 50.0, "decay_open": 400.0, "tone": 400.0, "tune": 0.0, "level": 0.5 }
    },
    {
      "id": 7,
      "type": "mixer",
      "name": "Mix",
      "params": { "gain1": 1.0, "gain2": 0.8, "gain3": 1.0, "gain4": 1.0, "master": 0.8 }
    },
    {
      "id": 8,
      "type": "speaker_output",
      "name": "Output",
      "params": { "gain": 0.9 }
    }
  ],
  "cables": [
    { "src_module_id": 1, "src_port": "out",  "dst_module_id": 2, "dst_port": "clock" },
    { "src_module_id": 2, "src_port": "div2", "dst_module_id": 3, "dst_port": "clock" },
    { "src_module_id": 2, "src_port": "divn", "dst_module_id": 3, "dst_port": "reset" },
    { "src_module_id": 3, "src_port": "cv",   "dst_module_id": 4, "dst_port": "pitch_cv" },
    { "src_module_id": 3, "src_port": "gate", "dst_module_id": 4, "dst_port": "trigger" },
    { "src_module_id": 1, "src_port": "out",  "dst_module_id": 5, "dst_port": "clock" },
    { "src_module_id": 2, "src_port": "divn", "dst_module_id": 5, "dst_port": "reset" },
    { "src_module_id": 5, "src_port": "gate", "dst_module_id": 6, "dst_port": "closed_trigger" },
    { "src_module_id": 5, "src_port": "cv",   "dst_module_id": 6, "dst_port": "vel" },
    { "src_module_id": 4, "src_port": "out",  "dst_module_id": 7, "dst_port": "in1" },
    { "src_module_id": 6, "src_port": "out",  "dst_module_id": 7, "dst_port": "in2" },
    { "src_module_id": 7, "src_port": "out",  "dst_module_id": 8, "dst_port": "in" }
  ]
}
