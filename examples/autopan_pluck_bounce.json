{
  "version": 1,
  "next_id": 8,
  "modules": [
    { "id": 1, "type": "clock", "name": "EIGHTHS - 96 bpm; the same cable plays the notes AND throws them",
      "params": { "bpm": 96.0, "division": 2.0, "pulse_width": 0.5 } },
    { "id": 2, "type": "sequencer", "name": "FIGURE - A minor pentatonic, 8 steps, one per eighth",
      "params": { "steps": 8, "direction": "forward",
        "step1_pitch": 0.0,  "step1_on": true, "step2_pitch": 7.0,  "step2_on": true,
        "step3_pitch": 12.0, "step3_on": true, "step4_pitch": 10.0, "step4_on": true,
        "step5_pitch": 3.0,  "step5_on": true, "step6_pitch": 15.0, "step6_on": true,
        "step7_pitch": 5.0,  "step7_on": true, "step8_pitch": 12.0, "step8_on": true } },
    { "id": 3, "type": "pluck", "name": "STRING - short, so each note lands on its side before the pan flips",
      "params": { "decay": 0.6, "damping": 0.4, "color": 0.8, "position": 0.2, "level": 0.7 } },
    { "id": 4, "type": "autopan", "name": "PING-PONG - square synced to the clock, division 2: one note left, the next right (0.8 Hz only places the first edge)",
      "params": { "pan": 0.0, "depth": 0.85, "rate": 0.8, "shape": "square", "tremolo": 0.0,
        "law": "power", "division": 2.0, "cv_depth": 1.0 } },
    { "id": 5, "type": "reverb", "name": "the room stays in the middle - the wash is not panned",
      "params": { "size": 0.6, "decay": 0.5, "damping": 0.4, "mix": 1.0 } },
    { "id": 6, "type": "stereo_speaker_output", "name": "Dry - thrown side to side", "params": { "gain": 0.8 } },
    { "id": 7, "type": "stereo_speaker_output", "name": "Wash - centred", "params": { "gain": 0.25 } }
  ],
  "cables": [
    { "src_module_id": 1, "src_port": "out",   "dst_module_id": 2, "dst_port": "clock" },
    { "src_module_id": 1, "src_port": "out",   "dst_module_id": 4, "dst_port": "clock" },
    { "src_module_id": 2, "src_port": "cv",    "dst_module_id": 3, "dst_port": "pitch_cv" },
    { "src_module_id": 2, "src_port": "gate",  "dst_module_id": 3, "dst_port": "trigger" },
    { "src_module_id": 3, "src_port": "out",   "dst_module_id": 4, "dst_port": "in_l" },
    { "src_module_id": 4, "src_port": "out_l", "dst_module_id": 6, "dst_port": "in_l" },
    { "src_module_id": 4, "src_port": "out_r", "dst_module_id": 6, "dst_port": "in_r" },
    { "src_module_id": 3, "src_port": "out",   "dst_module_id": 5, "dst_port": "in" },
    { "src_module_id": 5, "src_port": "out_l", "dst_module_id": 7, "dst_port": "in_l" },
    { "src_module_id": 5, "src_port": "out_r", "dst_module_id": 7, "dst_port": "in_r" }
  ],
  "ui": {
    "node_positions": {
      "1": [30, 200], "2": [320, 200], "3": [620, 200], "4": [900, 100],
      "5": [900, 380], "6": [1200, 100], "7": [1200, 380]
    }
  }
}
