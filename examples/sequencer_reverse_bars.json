{
  "version": 1,
  "next_id": 10,
  "modules": [
    {
      "id": 1,
      "type": "clock",
      "name": "Eighths (120 BPM)",
      "params": { "bpm": 120.0, "division": 2.0, "pulse_width": 0.5 }
    },
    {
      "id": 2,
      "type": "clock_divider",
      "name": "Divider - divn 8 = the bar line, into reset",
      "params": { "n": 8, "m": 2, "swing": 0.0, "pw": 0.5 }
    },
    {
      "id": 3,
      "type": "lfo",
      "name": "Bar-pair square - 0.25 Hz = two bars; phase 17/32 puts its edges half an eighth BEFORE each bar line",
      "params": { "waveform": "square", "rate": 0.25, "depth": 1.0, "bipolar": false, "cv_depth": 1.0, "phase": 0.53125 }
    },
    {
      "id": 4,
      "type": "schmitt",
      "name": "Square to gate (cv -> gate) - the reverse gate: low bar 1, high bar 2",
      "params": { "high": 0.6, "low": 0.4 }
    },
    {
      "id": 5,
      "type": "sequencer",
      "name": "Eight-step line - forward; every other bar runs backwards (a palindrome)",
      "params": {
        "steps": 8,
        "direction": "forward",
        "seed": 1,
        "step1_pitch": 0.0,  "step1_on": true,
        "step2_pitch": 3.0,  "step2_on": true,
        "step3_pitch": 7.0,  "step3_on": true,
        "step4_pitch": 10.0, "step4_on": true,
        "step5_pitch": 12.0, "step5_on": true,
        "step6_pitch": 15.0, "step6_on": true,
        "step7_pitch": 14.0, "step7_on": true,
        "step8_pitch": 19.0, "step8_on": true
      }
    },
    {
      "id": 6,
      "type": "pluck",
      "name": "Pluck (C4 base)",
      "params": { "decay": 1.2, "damping": 0.45, "color": 0.7, "position": 0.25, "level": 0.7 }
    },
    {
      "id": 7,
      "type": "delay",
      "name": "Dotted-eighth echo",
      "params": { "time": 375.0, "feedback": 0.3, "tone": 0.4, "mix": 0.25, "cv_depth": 50.0 }
    },
    {
      "id": 8,
      "type": "speaker_output",
      "name": "Output",
      "params": { "gain": 0.9 }
    }
  ],
  "cables": [
    { "src_module_id": 1, "src_port": "out",  "dst_module_id": 2, "dst_port": "clock" },
    { "src_module_id": 1, "src_port": "out",  "dst_module_id": 5, "dst_port": "clock" },
    { "src_module_id": 2, "src_port": "divn", "dst_module_id": 5, "dst_port": "reset" },
    { "src_module_id": 3, "src_port": "cv",   "dst_module_id": 4, "dst_port": "in" },
    { "src_module_id": 4, "src_port": "gate", "dst_module_id": 5, "dst_port": "reverse" },
    { "src_module_id": 5, "src_port": "cv",   "dst_module_id": 6, "dst_port": "pitch_cv" },
    { "src_module_id": 5, "src_port": "gate", "dst_module_id": 6, "dst_port": "trigger" },
    { "src_module_id": 6, "src_port": "out",  "dst_module_id": 7, "dst_port": "in" },
    { "src_module_id": 7, "src_port": "out",  "dst_module_id": 8, "dst_port": "in" }
  ]
}
