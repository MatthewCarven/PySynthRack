{
  "version": 1,
  "next_id": 9,
  "modules": [
    { "id": 1, "type": "clock", "name": "eighths at 96 - one pick per pulse",
      "params": { "bpm": 96.0, "division": 2.0, "pulse_width": 0.5 } },
    { "id": 2, "type": "sequencer", "name": "the line - a C minor pentatonic phrase (semitones from C4)",
      "params": { "steps": 8,
        "step1_pitch": 0.0,  "step1_on": true, "step2_pitch": 3.0,  "step2_on": true,
        "step3_pitch": 7.0,  "step3_on": true, "step4_pitch": 10.0, "step4_on": true,
        "step5_pitch": 12.0, "step5_on": true, "step6_pitch": 10.0, "step6_on": true,
        "step7_pitch": 7.0,  "step7_on": true, "step8_pitch": 3.0,  "step8_on": true } },
    { "id": 3, "type": "shift_random", "name": "TOUCH BOX - a looping 8-step accent pattern; probability 0 locks it, 0.1 lets it drift",
      "params": { "probability": 0.1, "length": 8, "range": 1.0, "bipolar": false, "seed": 11 } },
    { "id": 4, "type": "cv_scale", "name": "x0.65 - the accent span", "params": { "scale": 0.65 } },
    { "id": 5, "type": "cv_offset", "name": "+0.35 - the softest pick still speaks (vel 0.35..1.0)", "params": { "offset": 0.35 } },
    { "id": 6, "type": "pluck", "name": "STRING - THE TOUCH: vel_color 0.8 + vel_position 0.9, pick at 0.12 (by the bridge). A hard pick is loud, bright and nasal; a soft one is quiet, dull AND round - the softest pick here (vel 0.41) lands at 0.32, a third of the way in. carry on, so each re-pluck superposes exactly on the ringing string",
      "params": { "decay": 1.1, "damping": 0.35, "color": 0.85, "vel_color": 0.8, "position": 0.12, "vel_position": 0.9, "carry": true, "level": 0.75 } },
    { "id": 7, "type": "reverb", "name": "a little room",
      "params": { "size": 0.55, "decay": 0.45, "damping": 0.45, "mix": 0.22 } },
    { "id": 8, "type": "stereo_speaker_output", "name": "Output", "params": { "gain": 0.9 } }
  ],
  "cables": [
